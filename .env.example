# DeepSeek API Key（必填，用于对话与 Agent）
# 获取：https://platform.deepseek.com/usage
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Tavily API Key（开启 Agent 模式 / 联网搜索时必填）
# 获取：https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key

# 可选：服务端口，默认 8787
PORT=8787

# 可选：DeepSeek 余额查询端点（一般无需修改）
DEEPSEEK_BALANCE_URL=https://api.deepseek.com/v1/user/balance

# 可选：API 访问令牌，用于保护后端接口（推荐设置）
API_ACCESS_TOKEN=your-secret-token
